{
  "name": "@standhigher/charts",
  "version": "1.2.1",
  "description": "Reusable React chart components for Shopify Polaris-style dashboards.",
  "license": "MIT",
  "author": "Standhigher",
  "homepage": "https://standhigher.github.io/shopify-polaris-charts/",
  "bugs": {
    "url": "https://github.com/standhigher/shopify-polaris-charts/issues"
  },
  "keywords": [
    "react",
    "charts",
    "recharts",
    "shopify",
    "polaris",
    "shopify-polaris",
    "dashboard",
    "analytics",
    "data-visualization",
    "typescript",
    "storybook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/shopify-polaris-charts.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/api.md",
    "docs/api.zh-CN.md",
    "docs/usage.md",
    "docs/usage.zh-CN.md",
    "docs/migration-v1.md",
    "docs/migration-v1.zh-CN.md",
    "docs/upgrade-guide.md",
    "docs/upgrade-guide.zh-CN.md",
    "docs/release-checklist.md",
    "docs/shopify-analytics-patterns.md",
    "docs/shopify-analytics-patterns.zh-CN.md",
    "docs/performance/v1.0-budget.md",
    "docs/public-api/index.d.ts",
    "docs/public-api/formatters.d.ts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formatters": {
      "types": "./dist/formatters.d.ts",
      "import": "./dist/formatters.js"
    }
  },
  "scripts": {
    "api:check": "node scripts/public-api-report.mjs",
    "api:write": "node scripts/public-api-report.mjs --write",
    "benchmark:analytics": "npm run build && node --expose-gc scripts/benchmark-analytics.mjs",
    "build": "tsup",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "formatters:smoke": "npm run build && node scripts/formatter-subpath-smoke.mjs",
    "next:smoke": "npm run build && node scripts/next-app-smoke.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "peer:smoke": "npm run build && node scripts/peer-matrix-smoke.mjs",
    "prepublishOnly": "npm run lint && npm run test && npm run typecheck && npm run build && npm run api:check && npm run build-storybook && npm run benchmark:analytics && npm run peer:smoke && npm run formatters:smoke && npm run next:smoke && npm run vite:smoke && npm run pack:dry-run",
    "vite:smoke": "npm run build && node scripts/vite-consumer-smoke.mjs"
  },
  "peerDependencies": {
    "@shopify/polaris": ">=12",
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20",
    "recharts": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "@shopify/polaris": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "storybook": "^10.5.7",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20 <25"
  }
}
